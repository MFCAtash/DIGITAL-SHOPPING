{
  "uid": "codex-overview",
  "title": "Digital Shopping — Overview",
  "tags": ["codex", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "نرخ درخواست (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(codex_http_requests_total[5m]))", "legendFormat": "همه", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "نرخ خطای ۵xx",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(codex_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "۵xx", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "تأخیر p95 (ثانیه)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(codex_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "سفارش و پرداخت",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(codex_orders_created_total[5m]))", "legendFormat": "سفارش", "refId": "A" },
        { "expr": "sum(rate(codex_orders_paid_total[5m]))", "legendFormat": "پرداخت", "refId": "B" },
        { "expr": "sum(rate(codex_payments_failed_total[5m]))", "legendFormat": "ناموفق", "refId": "C" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "وضعیت سرویسها",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] }
    }
  ]
}
