# نحوهٔ نرمالسازی خطوط در مخزن
* text=auto eol=lf

# اسکریپتهای ویندوزی
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# اسکریپتهای شل و پیکربندی
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.html text eol=lf

# فایلهای باینری (نباید نرمال شوند)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.woff binary
*.ico binary
*.pdf binary
*.gz binary
*.zip binary

# زبانها و GitHub Linguist
*.css linguist-language=CSS
docs/legacy-overlay/** linguist-documentation
packages/ui/preview/** linguist-generated
contracts/openapi.json linguist-generated
