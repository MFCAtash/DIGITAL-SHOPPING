# آدرس API بکاند (از طریق rewite در next.config، مرورگر فقط /api میبیند)
API_BASE_URL=http://localhost:8000/api/v1
# آدرس عمومی فروشگاه برای metadata و نقشه سایت
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# زبان پیشفرض رابط (fa | en). زبان de فعلاً به تعویق افتاده است.
NEXT_PUBLIC_DEFAULT_LOCALE=fa
# تنها در صورت استفاده از عکسهای روی میزبان خارجی: نام میزبان مجاز (بدون https://)
# NEXT_PUBLIC_MEDIA_HOSTNAME=media.example.com
