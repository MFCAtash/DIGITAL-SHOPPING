# کپی کنید به .env و مقدارها را عوض کنید. هرگز .env را در Git نگذارید (gitleaks در CI بررسی میکند).
# تمام مقادیر زیر نمونهاند؛ هیچ راز واقعی در این فایل نیست.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost
# دامنه‌های فرانت (allowlist دقیق CORS)، جدا با ویرگول
CORS_ALLOWED_ORIGINS=https://localhost
POSTGRES_PASSWORD=change-me
# production: حتماً sslmode=require (یا verify-full) و یک دیتابیس با TLS. security.E014 همین را الزام میکند.
# توسعهٔ محلی با postgres بدون TLS: sslmode=disable بگذارید ولی هرگز آنرا به production نبرید.
DATABASE_URL=postgres://codex:change-me@db:5432/codex?sslmode=require
# exporter باید همان سیاست TLS دیتابیس را داشته باشد (پیشفرض: require، مطابق DATABASE_URL).
POSTGRES_SSLMODE=require
# برندهایی که پنهان میمانند (پیشفرض: Starlink؛ نگاه کنید به README بخش ریسکها). تطابق case-insensitive است.
HIDDEN_BRANDS=Starlink
ORDER_EXPIRY_MINUTES=15
# مسیر اختیاری کاتالوگ برای import_catalog؛ خالی = overlay/data/real-catalog.json
CATALOG_JSON=
# قیمتهای قدیمیتر از این تعداد روز «قدیمی» حساب میشوند
PRICE_STALE_DAYS=7
# prod: عکس بدون مجوز ⇒ آگهی منتشر نمیشود (پیشفرض True). فقط در staging میشود False کرد.
# دفتر حقوق عکسها در overlay/data/image-rights.json است؛ عکسهای «needs-review» با مجوز source-attribution ثبت میشوند.
REQUIRE_IMAGE_LICENSE=True
# migrationها را فقط deploy.yml اجرا میکند؛ entrypoint و worker نباید دوباره migrate کنند.
RUN_MIGRATIONS=0
# محدودیت نرخ API (ninja). SSR فرانت از یک IP میآید؛ مقدار را متناسب بگذارید.
API_THROTTLE_ANON=300/min
API_THROTTLE_AUTH=600/min
# تعداد پروکسیهای جلوی api (Caddy = 1) برای تشخیص IP واقعی
NUM_PROXIES=1
LOG_LEVEL=INFO
SITE_ADDRESS=localhost
# IP/CIDRهای مجاز برای /admin/ (جدا با فاصله)
ADMIN_ALLOWED_IPS=127.0.0.1/32 ::1/128
DJANGO_SETTINGS_MODULE=config.settings.prod
# در production پشت Caddy (که X-Forwarded-Proto: https میفرستد) True بماند؛ False فقط برای اجرای محلی بدون HTTPS/پروکسی.
SECURE_SSL_REDIRECT=True

# --- مرحلهٔ ۲ و ۳ ---
# کلید HMAC کدهای OTP (جدا از SECRET_KEY و تصادفی)
OTP_SECRET=change-me-otp-secret
# آداپتور پیامک (کلاس با متد send). prod: کلاس ارائهدهندهٔ واقعی؛ ConsoleSms کد را در لاگ مینویسد (فقط توسعه)
# در محیط تولید حتماً HttpSms (ConsoleSms کد OTP را در لاگ مینویسد و توسط prod.py رد میشود)
SMS_GATEWAY=apps.accounts.sms.HttpSms
SMS_HTTP_URL=https://sms.example.com/api/send
SMS_HTTP_TOKEN=change-me-sms-token
# timeout ارسال پیامک به ارائهدهنده (ثانیه)
SMS_HTTP_TIMEOUT=5
# true فقط برای توسعه/تست بدون worker؛ در prod ارسال با procrastinate
SMS_SEND_INLINE=False
# آداپتورهای اعلان ایمیل/پوش (مسیر کلاس یا تابع با امضای (user, notification))؛ خالی = اعلان ناموفق ثبت میشود.
NOTIFICATION_EMAIL_ADAPTER=
NOTIFICATION_PUSH_ADAPTER=
DEFAULT_FROM_EMAIL=no-reply@example.com
# درگاه پرداخت: در prod مقدار http الزامی است (fake توسط prod.py رد میشود)
PAYMENT_GATEWAY=http
PAYMENT_START_URL=https://pay.example.com/start
PAYMENT_VERIFY_URL=https://pay.example.com/verify
# آدرس API بازپرداخت درگاه (وقتی PAYMENT_GATEWAY=http)؛ خالی ⇒ refund_payment با خطای امن متوقف میشود.
PAYMENT_REFUND_URL=https://pay.example.com/refund
PAYMENT_API_KEY=change-me-payment-key
PAYMENT_CALLBACK_SECRET=change-me-callback-secret
PAYMENT_AMOUNT_UNIT=toman
VAT_PERCENT=10
# سقف تعداد کالای گرانقیمت (۲ یا ۳؛ تصمیم کسبوکار)
CART_HIGH_VALUE_USD_CENTS=50000
CART_HIGH_VALUE_MAX_QTY=2
CART_DEFAULT_MAX_QTY=10
CART_RETENTION_DAYS=30
# مهلت درخواست مرجوعی پس از تحویل (روز)
RETURN_WINDOW_DAYS=7
# پرداخت: فقط درگاه آزمایشی «fake» پیاده شده؛ PAYMENT_SANDBOX در prod هرگز True نشود
# staging/sandbox تنها در صورت نیاز ویژه PAYMENT_GATEWAY=fake و PAYMENT_SANDBOX=True را صریح تنظیم کنید.
# در production هرگز fake مجاز نیست (prod.py و system checkها جلوگیری میکنند).
PAYMENT_SANDBOX=False
FAKE_GATEWAY_SCENARIO=success
PAYMENT_HOLD_MINUTES=30
PAYMENT_RETRY_AFTER_SECONDS=120
PUBLIC_BASE_URL=https://localhost
FRONTEND_URL=https://localhost

# --- کش مشترک و رصد (فاز ۳) ---
# خالی گذاشتن REDIS_URL = کش محلی تکپروسه (برای توسعه). در تولید حتماً تنظیم شود.
# رمز REDIS_PASSWORD همان است که rotate-secrets.sh چاپ میکند و compose با --requirepass تنظیم میکند.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://change-me-redis-password@redis:6379/0
# پیشوند کلیدهای کش Redis (جدا نگه داشتن محیطها روی یک سرور)
CACHE_KEY_PREFIX=codex
# توکن الزامی /metrics در production؛ حتماً تصادفی و بلند باشد.
METRICS_TOKEN=change-me-to-a-long-random-metrics-token
# رمز ادمین Grafana (پیشفرض compose آنرا الزامی میکند).
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
# محدودیت نرخ مسیرهای حساس (علاوه بر policy داخلی OTP)
AUTH_OTP_THROTTLE=12/min
AUTH_PASSWORD_THROTTLE=8/min
# طول عمر لینک بازنشانی رمز (حداکثر ۳۶۰۰ ثانیه)
PASSWORD_RESET_TIMEOUT=900
# طول عمر نشست و کوکی CSRF (ثانیه)
SESSION_COOKIE_AGE=43200
CSRF_COOKIE_AGE=43200
# بسته شدن نشست با بسته شدن مرورگر (توسعه: false؛ prod بسته به سیاست امنیتی)
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# --- تستهای E2E وب (apps/web/playwright.config.ts) ---
# آدرس تحت تست؛ پیشفرض http://127.0.0.1:3000
E2E_BASE_URL=http://127.0.0.1:3000
# کانال مرورگر Playwright؛ مثلاً chrome (خالی = Chromium پیشفرض)
E2E_CHANNEL=
